---
import Layout from "../layouts/Layout.astro";
import PageJumpNav from "../components/PageJumpNav.astro";

const archivos = import.meta.glob("../evidencias/*.md", { eager: true }) as Record<
  string,
  { frontmatter: Record<string, any> }
>;

const entradas = Object.entries(archivos).map(([ruta, mod]) => ({
  slug: ruta.split("/").pop()!.replace(".md", ""),
  ...mod.frontmatter,
}));

const secciones = [
  { id: "modelado", titulo: "Modelado" },
  { id: "normalizacion", titulo: "Normalización" },
  { id: "sql", titulo: "SQL" },
  { id: "proyecto", titulo: "Proyecto" },
].map((s) => ({
  ...s,
  entradas: entradas
    .filter((e) => e.seccion === s.id)
    .sort((a, b) => Number(a.orden ?? 999) - Number(b.orden ?? 999)),
}));

const navItems = secciones.map((s) => ({ href: `#${s.id}`, label: s.titulo }));
---

<Layout
  title="Evidencias"
  description="Evidencias de aprendizaje del curso: modelado, normalización, SQL y proyecto."
  schemaType="CollectionPage"
>
  <div class="page-stack">
    <header class="page-header">
      <p class="page-kicker">Bases de Datos 1</p>
      <h1 class="page-title">Evidencias</h1>
      <p class="page-description">
        Acá voy a ir subiendo el trabajo del curso a lo largo del semestre.
      </p>
    </header>

    <PageJumpNav items={navItems} />

    <div class="space-y-7 sm:space-y-8">
      {secciones.map((seccion) => (
        <section id={seccion.id} class="content-section scroll-mt-20 space-y-4">
          <header class="border-b border-gray-200 pb-3 dark:border-gray-700">
            <h2 class="section-heading">{seccion.titulo}</h2>
          </header>

          {seccion.entradas.length === 0 ? (
            <p class="body-copy">Próximamente.</p>
          ) : (
            <div class="grid gap-4 md:grid-cols-2">
              {seccion.entradas.map((e) => (
                <a href={`/evidencias/${e.slug}`} class="group block h-full no-underline">
                  <article class="surface-card-hover flex h-full flex-col">
                    {e.imagen && (
                      <img
                        src={e.imagen}
                        alt={e.titulo}
                        loading="lazy"
                        class="mb-4 aspect-video w-full rounded-lg border border-gray-200 object-cover dark:border-gray-700"
                      />
                    )}
                    {e.fecha && (
                      <p class="entry-meta tabular-nums">{e.fecha}</p>
                    )}
                    <h3 class="entry-title mt-1 transition-colors group-hover:text-accent-700 dark:group-hover:text-accent-300">
                      {e.titulo}
                    </h3>
                    {e.resumen && (
                      <p class="entry-summary mt-2 line-clamp-3">{e.resumen}</p>
                    )}
                    <span class="mt-auto inline-flex min-h-11 items-center gap-2 pt-4 text-sm font-semibold text-accent-700 dark:text-accent-300">
                      Ver más
                      <span class="i-ph-arrow-right transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
                    </span>
                  </article>
                </a>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>
  </div>
</Layout>