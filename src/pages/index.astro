---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getFeaturedPapers } from "../lib/papers";
import siteConfig from "../side.config";
import { Image } from "astro:assets";

const showHero = siteConfig.homeBlocks.hero.enabled;
const showPublications = siteConfig.homeBlocks.publications.enabled;
const showPosts = siteConfig.homeBlocks.posts.enabled;

const recentPosts = showPosts
  ? (await getCollection("posts"))
      .filter((post) => !post.data.draft)
      .sort(
        (a, b) =>
          new Date(b.data.publishedAt).getTime() -
          new Date(a.data.publishedAt).getTime(),
      )
      .slice(0, 3)
  : [];

const selectedPapers = showPublications ? getFeaturedPapers(3) : [];
const postsSectionNumber = showPublications ? "02" : "01";

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;
const videoUrl = "https://www.youtube.com/embed/";
const about = {
  name: siteConfig.author,
  bio: siteConfig.hero.subheadline,
  avatar: profileImageUrl,
  socialLinks: siteConfig.socialLinks,
};

// Get affiliations and research interests from config
const affiliations = siteConfig.affiliations || [];
const researchInterests = siteConfig.researchInterests || [];
const statusBadge = siteConfig.hero.statusBadge;
const headline = siteConfig.hero.headline || about.name;
const profileAlt = siteConfig.hero.profileAlt || about.name;
---

<Layout
  title="Home"
  description={siteConfig.hero.subheadline}
  schemaType="ProfilePage"
>
  <div class="page-stack">
    {showHero && (
      <section class="relative border-y border-paper-300/90 py-8 dark:border-ink-700 sm:py-10 lg:py-12">
      <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_12rem] lg:items-start lg:gap-12">
        <div class="min-w-0">
          <h1 class="max-w-4xl font-heading text-[clamp(2.5rem,5vw,4.25rem)] font-semibold leading-[0.98] tracking-[-0.035em] text-gray-900 dark:text-gray-50">
            {headline}
          </h1>

          {affiliations.length > 0 && (
            <div class="mt-5 border-l-2 border-accent-500 pl-4">
              <div class="space-y-1">
                {affiliations.map((aff) => (
                  <p class="text-base leading-7 text-gray-600 dark:text-gray-300">
                    {aff.role}
                    {aff.department && <span>, {aff.department}</span>}
                    {aff.url ? (
                      <a
                        href={aff.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="ml-1 font-semibold text-accent-700 underline decoration-accent-300 underline-offset-4 transition-colors hover:text-accent-900 dark:text-accent-300 dark:decoration-accent-700 dark:hover:text-accent-100"
                      >
                        {aff.institution}
                      </a>
                    ) : (
                      <span>, {aff.institution}</span>
                    )}
                  </p>
                ))}
              </div>
            </div>
          )}

          <p class="mt-5 max-w-[43rem] text-[1.0625rem] leading-7 text-gray-700 dark:text-gray-200">
            {about.bio}
          </p>

          {researchInterests.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2" aria-label="Research interests">
              {researchInterests.map((interest, index) => (
                <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.08em] text-gray-600 dark:text-gray-300">
                  <span class="font-mono text-xs text-accent-600 dark:text-accent-300">{String(index + 1).padStart(2, "0")}</span>
                  {interest}
                </span>
              ))}
            </div>
          )}

          <div class="mt-6 flex flex-wrap gap-2">
            {about.socialLinks.slice(0, 5).map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="glass-control inline-flex min-h-11 items-center justify-center gap-2 px-3.5 py-2 text-sm font-semibold text-gray-700 no-underline transition-colors duration-150 hover:text-accent-800 dark:text-gray-200 dark:hover:text-accent-200"
                aria-label={link.label}
              >
                <span class={`${link.icon} text-base`} aria-hidden="true" />
                <span>{link.label}</span>
              </a>
            ))}
          </div>
        </div>

        <aside class="mx-auto w-full max-w-48 lg:mx-0" aria-label="Profile">
          <div class="relative overflow-hidden rounded-lg border border-paper-300 bg-white/64 p-1.5 dark:border-ink-700 dark:bg-ink-900/68">
              <Image
                src={about.avatar}
                alt={profileAlt}
                width={siteConfig.hero.profileImageWidth || 160}
                height={siteConfig.hero.profileImageHeight || 160}
                layout="constrained"
                fit="cover"
                priority
                class="aspect-square h-auto w-full rounded-md object-cover"
              />
          </div>
          {statusBadge && (
            <p class="mt-4 flex items-center justify-center gap-2 text-center text-xs font-semibold uppercase tracking-[0.1em] text-emerald-700 dark:text-emerald-300 lg:justify-start">
              <span class="h-2 w-2 rounded-full bg-emerald-500 ring-4 ring-emerald-100 dark:ring-emerald-900/40" aria-hidden="true"></span>
              {statusBadge}
            </p>
          )}
        </aside>
      </div>
      </section>
    )}

    <section class="content-section space-y-4" aria-labelledby="presentacion">
      <div class="border-b border-gray-300 pb-4 dark:border-gray-700">
        <p class="section-kicker">01 / Presentación</p>
        <h2 id="presentacion" class="section-heading">Un poco sobre mí</h2>
      </div>

      <div class="aspect-video w-full overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700">
        <iframe
          class="h-full w-full"
          src={videoUrl}
          title="Video de presentación"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>

      <div class="space-y-3">
        <p class="body-copy">
          Me gusta que me llamen Samuel o Samue. Soy ..... intereses .
        </p>
        <p class="body-copy">
          Creo que Bases de Datos 1 me va a ayudar en mi vida profesional porque...... me enseñara diferentes aspectos ....
        </p>
        <p class="body-copy font-semibold">
          Este semestre quiero demostrar que soy una persona responsable y inteligente.
        </p>
      </div>
    </section>

  </div>
</Layout>

<script>
  import { setupAbstractToggles } from "../scripts/ui";

  document.addEventListener("astro:page-load", () => {
    setupAbstractToggles();
  });
</script>
