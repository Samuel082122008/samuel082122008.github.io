---
import Layout from "../layouts/Layout.astro";
import siteConfig from "../side.config";
import { Image } from "astro:assets";

const rawProfileImage = siteConfig.hero.profileImage.trim();
const profileImageUrl = /^https?:/i.test(rawProfileImage)
  ? rawProfileImage
  : rawProfileImage.startsWith("/")
    ? rawProfileImage
    : new URL(
        rawProfileImage.startsWith(".")
          ? rawProfileImage
          : `../${rawProfileImage}`,
        import.meta.url,
      ).href;

const videoUrl = "https://www.youtube.com/embed/5qxG6ODQw1Q";

const affiliations = siteConfig.affiliations || [];
const tecnologias = siteConfig.researchInterests || [];
const statusBadge = siteConfig.hero.statusBadge;
const profileAlt = siteConfig.hero.profileAlt || siteConfig.author;

const [primerNombre, ...resto] = siteConfig.author.trim().split(/\s+/);
const apellidos = resto.join(" ");

const datos = [
  { icono: "i-ph-cake", titulo: "18 años", detalle: "Edad" },
  { icono: "i-ph-graduation-cap", titulo: "Ing. de Sistemas", detalle: "Universidad El Bosque" },
  { icono: "i-ph-map-pin", titulo: "Bogotá", detalle: "Colombia" },
  { icono: "i-ph-database", titulo: "Bases de Datos 1", detalle: "Curso del semestre" },
];

const aficiones = [
  { icono: "i-ph-game-controller", titulo: "Videojuegos", detalle: "Jugar", gradiente: "from-violet-500 to-fuchsia-500" },
  { icono: "i-ph-music-notes", titulo: "Música", detalle: "Escuchar", gradiente: "from-fuchsia-500 to-pink-500" },
  { icono: "i-ph-soccer-ball", titulo: "Fútbol", detalle: "Verlo y jugarlo", gradiente: "from-emerald-500 to-cyan-500" },
  { icono: "i-ph-lightbulb", titulo: "Aprender", detalle: "Siempre algo nuevo", gradiente: "from-amber-500 to-pink-500" },
];

const palabras = [...tecnologias, "Bases de Datos 1", "Universidad El Bosque", "Bogotá"];
const cinta = [...palabras, ...palabras, ...palabras, ...palabras];
---

<Layout
  title="Presentación"
  description={siteConfig.hero.subheadline}
  schemaType="ProfilePage"
>
  <div class="page-stack">
    <!-- ================= HERO ================= -->
    <section class="relative isolate overflow-hidden rounded-[2rem] border border-violet-200/70 bg-white/55 p-6 shadow-2xl dark:border-white/10 dark:bg-ink-900/50 sm:p-10 lg:p-14">
      <div class="fx-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="fx-blob fx-blob-violet fx-float -right-16 -top-20 -z-10 h-72 w-72" aria-hidden="true"></div>
      <div class="fx-blob fx-blob-pink fx-float-slow -bottom-24 -left-12 -z-10 h-72 w-72" aria-hidden="true"></div>
      <div class="fx-blob fx-blob-cyan fx-float-slow bottom-8 right-1/3 -z-10 h-56 w-56" aria-hidden="true"></div>

      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div class="min-w-0">
          {statusBadge && (
            <p class="fx-rise inline-flex items-center gap-2 rounded-full border border-emerald-400/50 bg-emerald-500/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-300">
              <span class="fx-pulse h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
              {statusBadge}
            </p>
          )}

          <p class="fx-rise fx-d1 mt-6 text-lg font-semibold text-violet-700 dark:text-violet-300">
            ¡Hola! Soy
          </p>

          <h1 class="fx-rise fx-d1 font-heading text-[clamp(3rem,8vw,5.75rem)] font-bold leading-[0.95] tracking-[-0.04em]">
            <span class="fx-gradient-text">{primerNombre}</span>
            {apellidos && (
              <span class="mt-2 block font-semibold tracking-[-0.02em] text-ink-800 dark:text-paper-100" style="font-size: 0.4em;">
                {apellidos}
              </span>
            )}
          </h1>

          {affiliations.length > 0 && (
            <div class="fx-rise fx-d2 mt-6 flex flex-wrap gap-2">
              {affiliations.map((aff) => (
                <p class="inline-flex flex-wrap items-center gap-x-1.5 gap-y-1 rounded-2xl border border-violet-200/70 bg-white/70 px-3.5 py-2 text-sm text-ink-700 dark:border-white/10 dark:bg-white/5 dark:text-paper-200">
                  <span class="i-ph-graduation-cap text-lg text-violet-600 dark:text-violet-300" aria-hidden="true"></span>
                  <span>{aff.role}</span>
                  {aff.url ? (
                    <a
                      href={aff.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-bold text-violet-700 underline decoration-violet-300 underline-offset-4 hover:text-violet-900 dark:text-violet-300 dark:decoration-violet-700 dark:hover:text-violet-100"
                    >
                      {aff.institution}
                    </a>
                  ) : (
                    <span>· {aff.institution}</span>
                  )}
                </p>
              ))}
            </div>
          )}

          <p class="fx-rise fx-d3 mt-5 max-w-[40rem] text-[1.0625rem] leading-7 text-ink-700 dark:text-paper-200">
            {siteConfig.hero.subheadline}
          </p>

          {tecnologias.length > 0 && (
            <div class="fx-rise fx-d3 mt-5 flex flex-wrap gap-2" aria-label="Tecnologías de interés">
              {tecnologias.map((t) => (
                <span class="fx-chip">{t}</span>
              ))}
            </div>
          )}

          <div class="fx-rise fx-d4 mt-7 flex flex-wrap gap-3">
            {siteConfig.socialLinks.slice(0, 5).map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="fx-btn"
                aria-label={link.label}
              >
                <span class={`${link.icon} text-lg`} aria-hidden="true" />
                <span>{link.label}</span>
              </a>
            ))}
          </div>
        </div>

        <aside class="relative mx-auto w-full max-w-72" aria-label="Foto de perfil">
          <div class="fx-ring absolute -inset-4 rounded-[2.25rem]" aria-hidden="true"></div>
          <div class="fx-float relative overflow-hidden rounded-[1.75rem] border-4 border-white/90 bg-white shadow-2xl dark:border-ink-800 dark:bg-ink-900">
            <Image
              src={profileImageUrl}
              alt={profileAlt}
              width={siteConfig.hero.profileImageWidth || 160}
              height={siteConfig.hero.profileImageHeight || 160}
              layout="constrained"
              fit="cover"
              priority
              class="aspect-square h-auto w-full object-cover"
            />
          </div>
        </aside>
      </div>
    </section>

    <!-- ================= CINTA DE TECNOLOGÍAS ================= -->
    <div class="fx-marquee rounded-2xl" aria-hidden="true">
      <div class="fx-marquee-track">
        {cinta.map((palabra) => (
          <span class="fx-marquee-item">{palabra}</span>
        ))}
      </div>
    </div>

    <!-- ================= DATOS RÁPIDOS ================= -->
    <section class="fx-reveal grid grid-cols-2 gap-4 lg:grid-cols-4" aria-label="Datos rápidos">
      {datos.map((d) => (
        <article class="fx-card flex items-center gap-3 p-4">
          <span class="fx-icon bg-gradient-to-br from-violet-500 to-fuchsia-500" style="width: 2.5rem; height: 2.5rem; font-size: 1.25rem;">
            <span class={d.icono} aria-hidden="true"></span>
          </span>
          <div class="min-w-0">
            <p class="font-heading text-base font-bold leading-tight text-ink-900 dark:text-paper-50">{d.titulo}</p>
            <p class="text-sm text-ink-600 dark:text-paper-300">{d.detalle}</p>
          </div>
        </article>
      ))}
    </section>

    <!-- ================= VIDEO ================= -->
    <section class="fx-reveal space-y-5" aria-labelledby="presentacion">
      <div>
        <p class="section-kicker">Presentación</p>
        <h2 id="presentacion" class="section-heading">Un poco sobre mí</h2>
      </div>

      <div class="fx-frame">
        <div class="aspect-video w-full overflow-hidden rounded-[1.2rem] bg-black">
          <iframe
            class="h-full w-full"
            src={videoUrl}
            title="Video de presentación"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- ================= QUIÉN SOY / OBJETIVO ================= -->
    <section class="fx-reveal grid gap-5 md:grid-cols-2">
      <article class="fx-card space-y-3 p-6">
        <div class="flex items-center gap-3">
          <span class="fx-icon bg-gradient-to-br from-violet-500 to-fuchsia-500">
            <span class="i-ph-user-circle" aria-hidden="true"></span>
          </span>
          <h3 class="entry-title">Quién soy</h3>
        </div>
        <p class="body-copy">
          Soy Samuel, tengo 18 años y me gradué del Colegio Corazonista.
          Actualmente soy estudiante de Ingeniería de Sistemas en la
          Universidad El Bosque.
        </p>
        <p class="body-copy">
          Me gusta todo lo relacionado con la tecnología y la programación, y
          durante la carrera he ido descubriendo diferentes áreas que me llaman
          la atención y en las que quiero seguir aprendiendo.
        </p>
      </article>

      <article class="fx-card space-y-3 p-6">
        <div class="flex items-center gap-3">
          <span class="fx-icon bg-gradient-to-br from-cyan-500 to-violet-500">
            <span class="i-ph-target" aria-hidden="true"></span>
          </span>
          <h3 class="entry-title">Mi objetivo este semestre</h3>
        </div>
        <p class="body-copy">
          Quiero aprender y entender mejor todo lo relacionado con Bases de
          Datos 1, especialmente cómo organizar y manejar la información de
          manera correcta.
        </p>
        <p class="body-copy">
          También quiero ser más constante con mis trabajos, mejorar mis
          habilidades y poder aplicar lo aprendido en futuros proyectos de mi
          carrera.
        </p>
      </article>
    </section>

    <!-- ================= FUERA DE LA UNIVERSIDAD ================= -->
    <section class="fx-reveal space-y-5" aria-labelledby="aficiones">
      <div>
        <p class="section-kicker">Fuera de la universidad</p>
        <h2 id="aficiones" class="section-heading">Lo que me gusta</h2>
      </div>

      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {aficiones.map((a) => (
          <article class="fx-card flex flex-col items-center gap-3 p-6 text-center">
            <span class={`fx-icon bg-gradient-to-br ${a.gradiente}`} style="width: 3.5rem; height: 3.5rem; font-size: 1.75rem;">
              <span class={a.icono} aria-hidden="true"></span>
            </span>
            <div>
              <p class="font-heading text-lg font-bold text-ink-900 dark:text-paper-50">{a.titulo}</p>
              <p class="text-sm text-ink-600 dark:text-paper-300">{a.detalle}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ================= TERMINAL ================= -->
    <section class="fx-reveal mx-auto w-full max-w-3xl" aria-label="Resumen en modo terminal">
      <div class="fx-terminal">
        <div class="fx-terminal-bar">
          <span class="fx-dot" style="background: #ff5f56;"></span>
          <span class="fx-dot" style="background: #ffbd2e;"></span>
          <span class="fx-dot" style="background: #27c93f;"></span>
          <span class="ml-3 font-mono text-xs text-white/60">samuel@portafolio: ~</span>
        </div>
        <div class="fx-terminal-body">
          <p><span class="fx-prompt">$</span>whoami</p>
          <p class="fx-out">Samuel, estudiante de Ingeniería de Sistemas</p>
          <p><span class="fx-prompt">$</span>cat stack.txt</p>
          <p class="fx-out">{tecnologias.join(" · ")}</p>
          <p><span class="fx-prompt">$</span>cat fuera_de_la_u.txt</p>
          <p class="fx-out">videojuegos · música · fútbol · aprender cosas nuevas</p>
          <p><span class="fx-prompt">$</span>echo $OBJETIVO_SEMESTRE</p>
          <p class="fx-out">dominar Bases de Datos 1 y ser más constante<span class="fx-blink">▍</span></p>
        </div>
      </div>
    </section>

    <!-- ================= BOTÓN A EVIDENCIAS ================= -->
    <a
      href="/evidencias"
      class="fx-cta group relative block overflow-hidden rounded-[2rem] p-8 text-white no-underline sm:p-10"
    >
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-white/80">Bases de Datos 1</p>
          <p class="mt-1 font-heading text-2xl font-bold sm:text-3xl">Mira mis evidencias del semestre</p>
          <p class="mt-1 text-white/85">Modelado, normalización, SQL y proyecto.</p>
        </div>
        <span class="inline-flex items-center gap-2 self-start rounded-full bg-white/20 px-5 py-2.5 text-sm font-bold backdrop-blur transition group-hover:bg-white/30 sm:self-auto">
          Ver evidencias
          <span class="i-ph-arrow-right transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true"></span>
        </span>
      </div>
    </a>
  </div>
</Layout>