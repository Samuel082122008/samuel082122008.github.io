import Layout from "../layouts/Layout.astro";
import siteConfig from "../side.config";

const videoUrl = "https://www.youtube.com/embed/TU_ID_DE_VIDEO"; // reemplazá esto (ver nota abajo)

<Layout
  title="Presentación"
  description="Video de presentación y una breve introducción sobre mí."
  schemaType="ProfilePage"
>
  <div class="page-stack">
    <header class="page-header">
      <p class="page-kicker">Presentación</p>
      <h1 class="page-title">¡Hola! Soy {siteConfig.author}</h1>
      <p class="page-description">Un poco sobre mí, en video y en texto.</p>
    </header>

    <div class="grid gap-8 md:grid-cols-[auto_minmax(0,1fr)] md:items-start">
      <img
        src={siteConfig.hero.profileImage}
        alt={siteConfig.hero.profileAlt}
        width={siteConfig.hero.profileImageWidth}
        height={siteConfig.hero.profileImageHeight}
        class="rounded-2xl border border-gray-200 dark:border-gray-700"
      />

      <div class="space-y-4">
        <p class="body-copy">
          Me gusta que me llamen ___. Soy ___ (algo breve: hobby, interés, música o deporte).
        </p>
        <p class="body-copy">
          Creo que Bases de Datos 1 me va a ayudar en mi vida profesional porque ___.
        </p>
        <p class="body-copy font-semibold">
          Este semestre quiero demostrar que ___.
        </p>
      </div>
    </div>

    <section class="content-section space-y-4">
      <header class="border-b border-gray-200 pb-3 dark:border-gray-700">
        <h2 class="section-heading">Video de presentación</h2>
      </header>
      <div class="aspect-video w-full overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-700">
        <iframe
          class="h-full w-full"
          src={videoUrl}
          title="Video de presentación"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </section>
  </div>
</Layout>